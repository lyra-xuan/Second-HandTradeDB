# ===========================================
#   校园二手交易平台 - 后端环境变量配置模板
#   使用方法：把本文件改名为 .env，然后填入你自己的真实配置
#   注意：.env 不要提交到 GitHub（已被 .gitignore 忽略）
# ===========================================


# ===== 数据库（MySQL）=====
# 格式：mysql+aiomysql://用户名:密码@127.0.0.1:3306/数据库名?charset=utf8mb4
DB_URI=mysql+aiomysql://root:your_password@127.0.0.1:3306/second_hand_trade?charset=utf8mb4


# ===== JWT Token 配置 =====
# JWT_SECRET_KEY：随便写一长串随机字符（越乱越安全），例如：kL9$mP2xQ7!vN4@bR8
JWT_SECRET_KEY=please_change_this_to_a_random_string
JWT_ACCESS_DAYS=15
